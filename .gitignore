# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
*.egg
*.whl

# --- Local virtual environments (recreate locally; never commit) ---
.venv/
venv/
env/
.env

# --- Testing and tooling caches ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Jupyter ---
.ipynb_checkpoints/
# Executed/temporary notebook copies and backups (source notebooks are tracked).
*.nbconvert.ipynb
*.executed.ipynb
*.ipynb.bak
*.ipynb~

# --- Editors and operating systems ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# --- Data ---
# Raw source CSVs are proprietary: keep them local and out of Git.
# Only the directory documentation is tracked.
data/raw/*
!data/raw/README.md
!data/raw/.gitkeep

# Generated datasets are reproducible and ignored by default.
data/interim/*
!data/interim/README.md
!data/interim/.gitkeep

data/processed/*
!data/processed/README.md
!data/processed/.gitkeep

# Defence in depth: never commit derived data exports anywhere in the repo.
# (JSON is protected by the directory rules above rather than globally,
# so tracked configuration files remain possible.)
*.csv
*.tsv
*.parquet
*.feather
*.pkl
*.pickle
*.zip
*.gz
*.bz2
*.xz
*.7z
*.tar

# --- Data-quality outputs ---
# Blank-row / rejected-row extracts, quality reports and audit files derived
# from the proprietary data are proprietary too: never commit them.
# (Source code, tests and docs are never matched: patterns name data/report
# extensions only; *.csv/*.parquet/... are already ignored globally above.)
*blank_rows*.json
*blank_rows*.txt
*blank_rows*.html
*rejected_rows*.json
*rejected_rows*.txt
*rejected_rows*.html
*removed_rows*.json
*removed_rows*.txt
*removed_rows*.html
*quality_report*.json
*quality_report*.txt
*quality_report*.html
*quality_metrics*.json
*quality_metrics*.txt
*quality_metrics*.html
*_audit.json
*_audit.txt
# Identifier extracts, type/dtype profiles and diagnostics from real data.
*identifier_values*
*identifier_extract*
*dtype_report*
*type_report*
*type_validation*.json
*type_validation*.txt
*type_validation*.html
*diagnostics*.json
*diagnostics*.txt
*diagnostics*.html
*.log
# Unique-key outputs: duplicate/missing-key extracts and key reports.
# (.csv/.parquet/... are already ignored globally above.)
*duplicate_key*.json
*duplicate_key*.txt
*duplicate_key*.html
*duplicate_key*.md
*duplicate_rows*.json
*duplicate_rows*.txt
*duplicate_rows*.html
*duplicate_rows*.md
*missing_key*.json
*missing_key*.txt
*missing_key*.html
*missing_key*.md
*key_report*.json
*key_report*.txt
*key_report*.html
*key_report*.md
*key_profile*.json
*key_profile*.txt
*key_profile*.html
*key_profile*.md

# --- Generated reports and figures ---
# Ignored by default; use `git add -f` to deliberately publish a final report.
reports/*
!reports/README.md
!reports/.gitkeep
!reports/figures/
reports/figures/*
!reports/figures/README.md
!reports/figures/.gitkeep
